@page
@model OrderEntrySystem.Web.Pages.Locations.CreateModel
@{
    <form method="post">
        <div class="mb-3">
            <label asp-for="Location.Name" class="form-label"></label>
            <input asp-for="Location.Name" class="form-control" placeholder="Location Name" />
        </div>
        <div class="mb-3">
            <label asp-for="Location.City" class="form-label"></label>
            <input asp-for="Location.City" class="form-control" placeholder="Location City" />
        </div>
        <div class="mb-3">
            <label asp-for="Location.State" class="form-label"></label>
            <input asp-for="Location.State" class="form-control" placeholder="Location State" />
        </div>

        <button type="submit" class="btn btn-primary">Create</button>
    </form>
}
