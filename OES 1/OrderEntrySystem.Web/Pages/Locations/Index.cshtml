@page
@model OrderEntrySystem.Web.Pages.Locations.IndexModel
@{
    ViewData["Title"] = "Locations";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" role="alert">
        @Model.StatusMessage
    </div>
}

<div>
    <h1>Locations <span class="badge bg-secondary rounded-pill">@Model.Locations.Count()</span></h1>
</div>

<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>ID</th>
            <th>Name</th>
            <th>City</th>
            <th>State</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var p in Model.Locations)
        {
            <tr>
                <td><input type="checkbox" class="row-select" value="@p.Id" /></td>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.City</td>
                <td>@p.State</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-page="./Index" asp-page-handler="Delete" asp-route-id="@p.Id"
                        method="post" style="display:inline"
                        onsubmit="return confirm('Are you sure you want to delete this location?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    Locations Selected: <span id="select-count">0</span>
</div>