@page
@model OrderEntrySystem.Web.Pages.Locations.CreatedModel
@{
    ViewData["Title"] = "Location Created";
    <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
        <i class="ti ti-check"></i>
        Location added to location list
    </div>
    <div class="card" style="max-width: 480px;">
        <div class="card-header">
            @Model.Location.Name
        </div>
        <div class="card-body p-0">
            <table class="table mb-0">
                <tr> <th>ID</th> <td>@Model.Location.Id</td> </tr>
                <tr> <th>Name</th> <td>@Model.Location.Name</td> </tr>
                <tr> <th>City</th> <td>@Model.Location.City</td> </tr>
                <tr> <th>State</th> <td>@Model.Location.State</td> </tr>
            </table>
        </div>
    </div>
}
