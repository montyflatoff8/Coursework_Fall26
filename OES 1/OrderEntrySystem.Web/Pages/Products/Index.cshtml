@page
@model OrderEntrySystem.Web.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" role="alert">
        @Model.StatusMessage
    </div>
}

<div>
    <h1>Products <span class="badge bg-secondary rounded-pill">@Model.Products.Count()</span></h1>
</div>

<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Category</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Products)
        {
            <tr>
                <td><input type="checkbox" class="row-select" value="@p.Id" /></td>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.Description</td>
                <td>@p.Quantity</td>
                <td>@p.Price</td>
                <td>@p.Category?.Name</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-page="./Index" asp-page-handler="Delete" asp-route-id="@p.Id"
                          method="post" style="display:inline"
                          onsubmit="return confirm('Are you sure you want to delete this product?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>