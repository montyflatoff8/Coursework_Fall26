@using OrderEntrySystem.Core.Models
@model IEnumerable<Order>

<h2>Orders</h2>
<table class="table">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.Status</td>
                <td>
                    <a asp-page="/Orders/Edit" asp-route-id="@order.Id" asp-route-customerId="@order.CustomerId" class="btn btn-sm btn-outline-secondary">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>