@page "{id:int}"
@model OrderEntrySystem.Web.Pages.Customers.DetailsModel
@{
    ViewData["Title"] = "Customer Details";
}
<h1>Customer</h1>
<div class="btn-toolbar p-2 border-bottom" role="toolbar" aria-label="Page actions">
    <a asp-page="/Orders/Create" asp-route-customerId="@Model.Customer.Id" class="btn btn-sm btn-primary">Create Order</a>
</div>
<div class="card" style="max-width: 480px;">
    <div class="card-header">
        @Model.Customer.Name
    </div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <tr><th>Name</th><td>@Model.Customer.Name</td></tr>
            <tr><th>Address</th><td>@Model.Customer.Address</td></tr>
        </table>
    </div>
</div>

<div class="mt-4">
    <partial name="_OrdersList" model="Model.Orders" />
</div>