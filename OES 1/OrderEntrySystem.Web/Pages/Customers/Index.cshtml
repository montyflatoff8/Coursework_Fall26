@page
@model OrderEntrySystem.Web.Pages.Customers.IndexModel
@{
    ViewData["Title"] = "Customers";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" role="alert">
        @Model.StatusMessage
    </div>
}

<div>
    <h1>Customers <span class="badge bg-secondary rounded-pill">@Model.Customers.Count()</span></h1>
</div>

<div>
    <a asp-page="./Create" class="btn btn-sm btn-outline-secondary">Create</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>Name</th>
            <th>Address</th>
            <th>Orders</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Customers)
        {
            var hasOrders = Model.CustomerIdsWithOrders.Contains(c.Id);

            <tr>
                <td><input type="checkbox" class="row-select" value="@c.Id" /></td>
                <td>@c.Name</td>
                <td>@c.Address</td>
                <td>@c.Orders.Count()</td>
                <td>
                    @if (hasOrders)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger" disabled
                                title="This customer has existing orders and cannot be deleted.">
                            Delete
                        </button>
                    }
                    else
                    {
                        <form asp-page="./Index" asp-page-handler="Delete" asp-route-id="@c.Id" method="post" style="display:inline"
                              onsubmit="return confirm('Are you sure you want to delete @c.Name?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    Customers Selected: <span id="select-count">0</span>
</div>