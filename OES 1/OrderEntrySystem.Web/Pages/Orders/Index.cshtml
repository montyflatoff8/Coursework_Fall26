@page
@model OrderEntrySystem.Web.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Orders";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" role="alert">
        @Model.StatusMessage
    </div>
}

<div>
    <h1>Orders <span class="badge bg-secondary rounded-pill">@Model.Orders.Count()</span></h1>
</div>

<div>
    <a asp-page="./Create" class="btn btn-sm btn-outline-secondary">Create</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>ID</th>
            <th>Customer</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model.Orders)
        {
            <tr>
                <td><input type="checkbox" class="row-select" value="@o.Id" /></td>
                <td>@o.Id</td>
                <td>@o.Customer?.Name</td>
                <td>@o.Status</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-page="./Index" asp-page-handler="Delete" asp-route-id="@o.Id"
                          method="post" style="display:inline"
                          onsubmit="return confirm('Are you sure you want to delete this order?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>