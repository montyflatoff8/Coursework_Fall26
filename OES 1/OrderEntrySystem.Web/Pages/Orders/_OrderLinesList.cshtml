@model IEnumerable<OrderEntrySystem.Core.Models.OrderLine>

<h3>Order Lines</h3>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var line in Model)
        {
            <tr>
                <td>@line.Product?.Name</td>
                <td>@line.Quantity</td>
                <td>
                    <a asp-page="/OrderLines/Edit" asp-route-id="@line.Id" asp-route-orderId="@line.OrderId" class="btn btn-sm btn-secondary">Edit</a>
                    <form method="post" asp-page-handler="DeleteLine" asp-route-lineId="@line.Id" style="display:inline"
                          onsubmit="return confirm('Remove this line?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>