@page "{id:int}"
@model OrderEntrySystem.Web.Pages.Orders.EditModel
@{
    ViewData["Title"] = "Edit Order";
}

<h1>Edit Order for @Model.CustomerName</h1>

<form method="post">
    <input type="hidden" asp-for="Order.Id" />
    <input type="hidden" asp-for="Order.CustomerId" />
    <input type="hidden" asp-for="CustomerId" />

    <div class="mb-3">
        <label asp-for="Order.Status" class="form-label">Order Status</label>
        <select asp-for="Order.Status" asp-items="Model.OrderStatusOptions" class="form-select"></select>
    </div>

    <button type="submit" class="btn btn-primary">Save changes</button>
</form>