@page "{id:int}"
@model OrderEntrySystem.Web.Pages.Products.DetailsModel
@{
    ViewData["Title"] = "Product Details";
}

<h1>@Model.Product.Name</h1>

<dl class="row">
    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Product.Description</dd>

    <dt class="col-sm-2">Price</dt>
    <dd class="col-sm-10">@Model.Product.Price.ToString("C")</dd>

    <dt class="col-sm-2">Categories</dt>
    <dd class="col-sm-10">
        @{
            var activeCategoryNames = Model.Product.ProductCategories
                .Where(pc => !pc.IsArchived && pc.Category != null && !pc.Category.IsArchived)
                .Select(pc => pc.Category!.Name);
        }
        @if (activeCategoryNames.Any())
        {
            @string.Join(", ", activeCategoryNames)
        }
        else
        {
            <em>No active categories</em>
        }
    </dd>
</dl>

<a asp-page="./Index" class="btn btn-sm btn-outline-secondary">Back to Products</a>