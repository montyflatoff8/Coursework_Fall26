@page
@model OrderEntrySystem.Web.Pages.Products.CreateModel
@{
    ViewData["Title"] = "Create Product";
}
    <div asp-validation-summary="All" class="text-danger"></div>
    <form method="post">
        <div class="mb-3">
            <label asp-for="Product.Name" class="form-label"></label>
            <input asp-for="Product.Name" class="form-control" placeholder="Product Name" />
        </div>
        <div class="mb-3">
            <label asp-for="Product.Description" class="form-label"></label>
            <input asp-for="Product.Description" class="form-control" placeholder="Product Description" />
        </div>
        <div class="mb-3">
            <label asp-for="Product.Quantity" class="form-label"></label>
            <input asp-for="Product.Quantity" class="form-control" placeholder="Product Quantity" />
        </div>
        <div class="mb-3">
            <label asp-for="Product.Price" class="form-label"></label>
            <input asp-for="Product.Price" class="form-control" placeholder="Product Price" />
        </div>
        <div class="mb-3">
            <label asp-for="Product.LocationId" class="form-label">Location</label>
            <select asp-for="Product.LocationId" asp-items="Model.LocationOptions" class="form-select">
                <option placeholder="">-- Select a location --</option>
            </select>
            <span asp-validation-for="Product.LocationId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Product.CategoryIds" class="form-label">Categories</label>
            <select asp-for="Product.CategoryIds" asp-items="Model.CategoryOptions" class="form-select" multiple size="6">
            </select>
            <span asp-validation-for="Product.CategoryIds" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Product.Condition" class="form-label">Condition</label>
            <select asp-for="Product.Condition" asp-items="Model.ConditionOptions" class="form-select">
				<option placeholder="">-- Select a condition --</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Create</button>
    </form>
