@page
@model OrderEntrySystem.Web.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categories";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" role="alert">
        @Model.StatusMessage
    </div>
}

<div>
    <h1>Categories <span class="badge bg-secondary rounded-pill">@Model.Categories.Count()</span></h1>
</div>

<div>
    <a asp-page="./Create" class="btn btn-sm btn-outline-secondary">Create</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>ID</th>
            <th>Name</th>
            <th>Products</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var c in Model.Categories)
        {
            <tr>
                <td><input type="checkbox" class="row-select" value="@c.Id" /></td>
                <td>@c.Id</td>
                <td>@c.Name</td>
                <td>@c.ProductCategories.Count()</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-page="./Index" asp-page-handler="Delete" asp-route-id="@c.Id"
                        method="post" style="display:inline"
                        onsubmit="return confirm('Are you sure you want to delete this category?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    Locations Selected: <span id="select-count">0</span>
</div>