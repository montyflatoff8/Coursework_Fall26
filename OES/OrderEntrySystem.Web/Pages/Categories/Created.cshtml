@page
@model OrderEntrySystem.Web.Pages.Categories.CreatedModel
@{
    ViewData["Title"] = "Category Created";
    <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
        <i class="ti ti-check"></i>
        Category added to category list
    </div>
    <div class="mb-3">
        <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">Categories List</a>
    </div>
    <div class="card" style="max-width: 480px;">
        <div class="card-header">
            @Model.Category.Name
        </div>
        <div class="card-body p-0">
            <table class="table mb-0">
                <tr> <th>ID</th> <td>@Model.Category.Id</td> </tr>
                <tr> <th>Name</th> <td>@Model.Category.Name</td> </tr>
            </table>
        </div>
    </div>
}
