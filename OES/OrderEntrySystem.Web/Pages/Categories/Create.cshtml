@page
@model OrderEntrySystem.Web.Pages.Categories.CreateModel
@{
    ViewData["Title"] = "Create Category";
}
    <form method="post">
        <div class="mb-3">
            <label asp-for="Category.Name" class="form-label"></label>
            <input asp-for="Category.Name" class="form-control" placeholder="Category Name" />
        </div>

        <button type="submit" class="btn btn-primary">Create</button>
    </form>
