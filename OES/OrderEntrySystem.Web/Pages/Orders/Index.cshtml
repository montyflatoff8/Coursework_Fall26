@page
@model OrderEntrySystem.Web.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Orders";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" role="alert">
        @Model.StatusMessage
    </div>
}

<div>
    <h1>Orders <span class="badge bg-secondary rounded-pill">@Model.Orders.Count()</span></h1>
</div>

<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>ID</th>
            <th>Customer</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model.Orders)
        {
            <tr>
                <td><input type="checkbox" class="row-select" value="@o.Id" /></td>
                <td>@o.Id</td>
                <td>@o.Customer?.Name</td>
                <td>@o.Status</td>
            </tr>
        }
    </tbody>
</table>