@page
@model OrderEntrySystem.Web.Pages.Orders.CreateModel
@{
    ViewData["Title"] = "Create Order";
}
    <div asp-validation-summary="All" class="text-danger"></div>
    <form method="post">
        <input type="hidden" asp-for="CustomerId" />

        @if (Model.CustomerId.HasValue)
        {
            <input type="hidden" asp-for="Order.CustomerId" />
            <p>Customer: <strong>@Model.CustomerName</strong></p>
        }
        
        <div class="mb-3">
            <label asp-for="Order.Status" class="form-label">Status</label>
            <select asp-for="Order.Status" asp-items="Model.OrderStatusOptions" class="form-select"></select>
            <span asp-validation-for="Order.Status" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Create Order</button>
    </form>
