@page "{id:int}"
@model OrderEntrySystem.Web.Pages.Orders.EditModel
@{
    ViewData["Title"] = "Edit Order";
}

<h1>Edit Order for @Model.CustomerName</h1>

<form method="post">
    <input type="hidden" asp-for="Order.Id" />
    <input type="hidden" asp-for="Order.CustomerId" />
    <input type="hidden" asp-for="CustomerId" />

    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-page="/OrderLines/Create" asp-route-orderId="@Model.Order.Id" class="btn btn-sm btn-primary">Add Line</a>
</form>

<partial name="_OrderLinesList" model="Model.OrderLines" />